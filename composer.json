{
  "name": "pxslip/laravel-scout-solr",
  "description": "A driver for the Laravel Scout search tools, using Apache Solr for the backend",
  "type": "library",
  "require": {
    "php": "^8.3",
    "laravel/scout": "^11.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "solarium/solarium": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "Scout\\Solr\\": "src/",
      "Scout\\Solr\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["Scout\\Solr\\ScoutSolrServiceProvider"]
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Will Kruse",
      "email": "wskruse@gmail.com"
    }
  ],
  "require-dev": {
    "illuminate/config": "^12.0|^13.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.5|^12.0",
    "squizlabs/php_codesniffer": "^3.13|^4.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
